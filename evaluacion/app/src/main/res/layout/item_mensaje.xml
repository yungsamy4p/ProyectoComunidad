<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <LinearLayout
        android:id="@+id/cardMensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_white"
        android:elevation="1dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvEmisorMensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profe Benja · #311A"
            android:textColor="@color/primary_teal"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvContenidoMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mensaje de ejemplo"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvFechaMensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="25/11 20:30"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>